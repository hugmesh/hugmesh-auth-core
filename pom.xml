<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>systems.snapdragon</groupId>
    <artifactId>snapdragon-parent</artifactId>
    <version>2.7.0</version>
    <relativePath/>
  </parent>

  <artifactId>snapdragon-auth-core</artifactId>
  <version>2.3.0</version>
  <packaging>jar</packaging>
  <name>snapdragon-auth-core</name>
  <description>Shared Snapdragon auth core (stateful): account/allowlist/bff-session store,
    Casdoor-admin client, MFA subsystem, session-cookie + internal-token filters. Depends
    on snapdragon-commons (stateless security/tenancy). Consumed by user-bff (login/OIDC)
    and admin-bff (admin features). NOT folded into commons so the gateway keeps a light,
    r2dbc-free classpath.</description>

  <dependencies>
    <!-- stateless security/tenancy/web building blocks (Casdoor authorities, ApiException) -->
    <dependency>
      <groupId>systems.snapdragon</groupId>
      <artifactId>snapdragon-commons</artifactId>
      <version>2.7.0</version>
    </dependency>
    <!-- reactive R2DBC for the @Table account/session/allowlist/mfa entities + repos -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-r2dbc</artifactId>
    </dependency>
    <!-- MFA subsystem crypto (TOTP HMAC + WebAuthn) — needed when the mfa/* classes land -->
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk18on</artifactId><version>1.80</version></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.80</version></dependency>
    <dependency><groupId>com.webauthn4j</groupId><artifactId>webauthn4j-core</artifactId><version>0.31.7.RELEASE</version></dependency>

    <!-- test: JUnit5/AssertJ/Mockito (starter-test) + reactor StepVerifier -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- commons test-support base class (PostgresTestSupport) for the Testcontainers-Postgres
         MFA-repo data slices: gen_random_uuid()/INSERT ... RETURNING (the DB-generated-UUID-PK
         migration) do NOT work on H2, so those slices run on REAL Postgres. The testcontainers
         stack (spring-boot-testcontainers / postgresql / junit-jupiter / r2dbc) is INHERITED
         from snapdragon-parent's common <dependencies>. -->
    <dependency>
      <groupId>systems.snapdragon</groupId>
      <artifactId>snapdragon-commons</artifactId>
      <version>2.7.0</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- LIBRARY, not a Boot app: no executable repackage -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration><skip>true</skip></configuration>
      </plugin>
    </plugins>
  </build>
</project>
